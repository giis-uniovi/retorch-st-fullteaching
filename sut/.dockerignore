# Without this file, Docker's build context (and the Dockerfile's
# `COPY src/main/angular/ ./` / `COPY src/ ./src/` steps) include local, host-only
# build output and dependency installs. Since those steps run *after* `npm install` /
# `mvn dependency:go-offline` inside the container, they silently overwrite the
# container's own fresh install with whatever is present on the host - e.g. a
# locally-installed node_modules left in a different (possibly inconsistent) state
# than package.json currently describes, corrupting the image's dependency versions
# without any error. Mirrors sut/.gitignore.

# Maven / Spring Boot build output
target/
bin/

# Spring Boot uploads / secrets
src/main/resources/amazon.properties
files/
pictures/
assets/

# Angular build output
src/main/angular/dist/
src/main/angular/.angular/

# npm dependencies (reinstalled via npm install)
node_modules/

# Angular test coverage
src/main/angular/coverage/

# Angular cache / temp
src/main/angular/.cache/
src/main/angular/out-tsc/

# SSL dev certs generated by the cert npm script
src/main/angular/key.pem
src/main/angular/cert.pem

# IDE / editor
.idea/
.settings/
.project
.classpath
*.iml
.vscode/

# OS
.DS_Store
Thumbs.db

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# VCS
.git/
